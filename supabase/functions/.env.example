# Secrets cho Edge Functions khi chạy local (copy thành supabase/functions/.env — đã gitignore).
# Trên Supabase thật: supabase secrets set APP_PIN=… VAPID_PUBLIC_KEY=… VAPID_PRIVATE_KEY=… VAPID_SUBJECT=… CRON_SECRET=…
APP_PIN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
